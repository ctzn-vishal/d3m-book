# Tigris credentials — only needed if you use scripts/fetch-article-data.mjs
# to pull pre-computed JSONs from a Tigris S3 bucket. If your data lives
# elsewhere, replace the fetch script with your own and ignore these.
TIGRIS_ENDPOINT=
TIGRIS_BUCKET_NAME=
TIGRIS_CLIENT_ID=
TIGRIS_CLIENT_SECRET=

# ── App env (set these in book-template/.env.local locally, and in Vercel) ──
# Live gallery registry (Turso). With a DB-scoped TURSO_AUTH_TOKEN the app reads
# live; a platform token is self-minted server-side (lib/turso-admin.ts), else it
# falls back to the committed snapshot. See docs/REGISTRY-CMS.md.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Shared password for the /admin CMS. Unset ⇒ /admin is locked (fails closed).
ADMIN_SECRET=
# Optional: secret for POST /api/revalidate (instant gallery refresh).
REVALIDATE_SECRET=
