{
  "name": "book-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fetch-data": "node --env-file=.env.local scripts/fetch-article-data.mjs",
    "sync-articles": "node --env-file=.env.local scripts/sync-articles.mjs",
    "rebuild-manifest": "node --env-file=.env.local scripts/rebuild-manifest.mjs",
    "sync-datasets": "node --env-file=.env.local scripts/sync-datasets.mjs",
    "sync-studios": "node --env-file=.env.local scripts/sync-studios.mjs",
    "sync-registry": "node --env-file=.env.local --import tsx scripts/sync-registry.ts",
    "migrate-gallery": "node --env-file=.env.local scripts/migrate-gallery.mjs",
    "migrate-timestamps": "node --env-file=.env.local scripts/migrate-timestamps.mjs",
    "mint-db-token": "node --env-file=.env.local scripts/mint-db-token.mjs",
    "studio": "drizzle-kit studio",
    "inject-chrome": "node --env-file=.env.local scripts/inject-chrome.mjs",
    "gen-story-sitemap": "node --env-file=.env.local scripts/gen-story-sitemap.mjs",
    "gen-thumbnails": "node --env-file=.env.local scripts/gen-thumbnails.mjs",
    "verify-content": "node --env-file=.env.local scripts/verify-content.mjs",
    "curate-new": "node --env-file=.env.local --import tsx scripts/curate-new.ts",
    "publish-content": "pnpm rebuild-manifest && pnpm sync-registry && pnpm inject-chrome && pnpm gen-story-sitemap && pnpm verify-content",
    "ship": "pnpm publish-content && pnpm curate-new"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.957.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.9",
    "@observablehq/plot": "^0.6.17",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@types/katex": "^0.16.8",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.23.26",
    "katex": "^0.16.47",
    "lucide-react": "^0.555.0",
    "next": "16.2.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.4",
    "rehype-katex": "^7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4",
    "remark-math": "^6",
    "tailwind-merge": "^3.4.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "us-atlas": "^3.0.1"
  },
  "packageManager": "pnpm@9.0.0"
}
